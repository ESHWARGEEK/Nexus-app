# GEMINI_API_KEY: Required for Gemini AI API calls when GENAI_MODE=mock or falling back to developer key.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Service Adapter Modes: 'mock' | 'real' (default: mock)
SEARCH_MODE="mock"
STT_MODE="mock"
DLP_MODE="mock"
STORE_MODE="mock"
ANALYTICS_MODE="mock"
AUTH_MODE="mock"
EXPORT_MODE="mock"
GENAI_MODE="real"

# Google Cloud Configuration for Real Services (Vertex AI / ADC)
PROJECT_ID="my-gcp-project-id"
GENAI_LOCATION="us-central1"
GEMINI_MODEL="gemini-3.8-flash"
DATASTORE_ID="enterprise-knowledge_1791893452016"
BIGQUERY_DATASET="nexus_analytics"

# GitHub Personal Access Token for Model Context Protocol (MCP) Codebase Access
GITHUB_PERSONAL_ACCESS_TOKEN="github_pat_..."
GITHUB_PAT="github_pat_..."
